# ==============================================================================
# CPL-2 Scheduling System — Environment Configuration
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# ─── Database ────────────────────────────────────────────────────────────────
# For local dev without Docker/PostgreSQL, leave empty or use SQLite:
#   DATABASE_URL=sqlite:///./cpl2_dev.db
# For Docker Compose or production PostgreSQL:
#   DATABASE_URL=postgresql://cpl2user:changeme@localhost:5432/cpl2_scheduling
DATABASE_URL=sqlite:///./cpl2_dev.db

# Used when running via Docker Compose (PostgreSQL container)
POSTGRES_DB=cpl2_scheduling
POSTGRES_USER=cpl2user
POSTGRES_PASSWORD=changeme

# ─── Authentication (Local JWT) ──────────────────────────────────────────────
# Secret key used to sign application JWT tokens.
# IN PRODUCTION: Generate a strong random key (e.g. `openssl rand -hex 32`)
JWT_SECRET=cpl2_dev_secret_key_change_in_production_min32chars

# Token lifetime in minutes (default: 60)
JWT_EXPIRY_MINUTES=60

# ─── Microsoft Entra ID (Azure AD) Authentication ───────────────────────────
# Optional: To enable Microsoft Entra ID single sign-on, configure your Azure App:
# 1. Register an application in Azure Portal -> Microsoft Entra ID -> App registrations.
# 2. Add Single-Page Application (SPA) redirect URI matching your frontend (e.g. http://localhost:5173).
# 3. Set the Client ID and Tenant ID below:
AZURE_CLIENT_ID=
AZURE_TENANT_ID=common

# Frontend exposure for Vite / MSAL.js
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=common

# ─── CORS & Network ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (supports local dev & production domains)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ─── File Storage ────────────────────────────────────────────────────────────
# Server-side path where uploaded XLS/XLSX files are stored.
# If left empty, automatically defaults to system temp directory (cpl2_uploads).
UPLOAD_PATH=./uploads

# ─── Frontend Build / Dev ────────────────────────────────────────────────────
# Base URL the frontend uses to communicate with the FastAPI backend API
VITE_API_BASE_URL=http://localhost:8000

# ─── Initial Admin / Seed Credentials (seed_users.py) ────────────────────────
SEED_PLANNER_USER=planner
SEED_PLANNER_PASS=planner123
SEED_VIEWER_USER=viewer
SEED_VIEWER_PASS=viewer123
